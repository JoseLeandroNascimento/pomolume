<journey name="Complete a focus session and review history">
    <description>With fresh app data, verify a one-minute focus session can be paused, resumed and completed, and that only one completed session appears in today's history.</description>
    <actions xml:space="preserve">
        <action>Verify that 'Sessão de foco' and the 'Iniciar' button are visible</action>
